{
	"name": "@jlynx_/acars-decoder",
	"version": "0.1.2",
	"description": "ACARS message parsing, reassembly and documented application decoding for browsers and Node.js",
	"type": "module",
	"license": "MIT",
	"author": {
		"name": "jLynx",
		"url": "https://github.com/jLynx"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jLynx/acars-typescript-decoder.git"
	},
	"homepage": "https://github.com/jLynx/acars-typescript-decoder#readme",
	"bugs": {
		"url": "https://github.com/jLynx/acars-typescript-decoder/issues"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"bin": {
		"acars-decode": "./dist/cli.js"
	},
	"exports": {
		"./framing": {
			"types": "./dist/framing.d.ts",
			"import": "./dist/framing.js"
		},
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./airports": {
			"types": "./dist/airports.d.ts",
			"import": "./dist/airports.js"
		},
		"./formats": {
			"types": "./dist/formats.d.ts",
			"import": "./dist/formats.js"
		}
	},
	"files": [
		"dist",
		"LICENSE",
		"THIRD_PARTY_NOTICES.txt",
		"CONTRIBUTING.md",
		"docs"
	],
	"scripts": {
		"build": "node scripts/build.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix --max-warnings 0",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"check:structure": "node scripts/check-structure.mjs",
		"check": "npm run lint && npm run format:check && npm run check:structure && npm run typecheck",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:data": "python -m unittest discover -s test/airport-db -p test_*.py",
		"test:package": "node scripts/package-smoke.mjs",
		"benchmark": "node scripts/benchmark.mjs",
		"test:upstream": "vitest run test/upstream",
		"compare:upstream": "npm run build && node scripts/upstream/compare.mjs",
		"release:check": "npm pack --dry-run",
		"build:airport-db": "python scripts/airport-db/build.py",
		"build:acars-labels": "python scripts/acars-data/build-labels.py",
		"prepack": "npm run check && npm test && npm run test:data && npm run build && npm run test:package"
	},
	"dependencies": {
		"@airframes/acars-decoder": "1.9.2",
		"pako": "^3.0.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.5",
		"@typescript/native": "npm:typescript@~7.0.2",
		"@vitest/coverage-v8": "^5.0.3",
		"esbuild": "^0.28.2",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.13.0",
		"prettier": "^3.9.9",
		"rollup": "^4.64.3",
		"rollup-plugin-dts": "^6.5.1",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.71.1",
		"vitest": "^5.0.3"
	},
	"engines": {
		"node": "^22.13.0 || >=24"
	},
	"keywords": [
		"acars",
		"aviation",
		"decoder",
		"ads-c",
		"cpdlc",
		"typescript",
		"miam"
	]
}
